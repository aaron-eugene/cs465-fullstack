{{!--
  layout.hbs
  ==========
  Main layout template for the Travlr application.

  Responsibilities:
  - Define shared HTML structure
  - Render dynamic page title
  - Inject page-specific content via {{{body}}}

  All views extend this layout.
--}}

<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    {{{body}}}
  </body>
</html>
